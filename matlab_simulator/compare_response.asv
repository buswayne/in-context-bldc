clc
close all
clear



list_factory = fieldnames(get(groot,'factory'));
index_interpreter = find(contains(list_factory,'Interpreter'));
for i = 1:length(index_interpreter)
    default_name = strrep(list_factory{index_interpreter(i)},'factory','default');
    set(groot, default_name,'latex');
end

models_to_test = ["test_l2_e32_h10_30k", ...
                  "test_l1_e32_h10_30k", ...
                  "test_l2_e16_h10_40k", ...
                  "test_l1_e16_h10_30k", ...
                  "test_l1_e12_h10_30k", ...
                  "test_l1_e8_h10_40k", ...
                  "test_l1_e4_h10_40k", ...
                  "test_l1_e2_h10_30k"];

num_params = [21829, ...
              12961, ...
              6513, ...
              3409, ...
              1981, ...
              937, ...
              277, ...
              91];



results = struct;


n_models = length(models_to_test);
temp_name = strsplit(pwd,'in-context-bldc');
user_tmp = strsplit(pwd,'Users\');
user_tmp2 = strsplit(user_tmp{2},'\');
user = user_tmp2{1};

datapath = fullfile(temp_name{1}, 'in-context-bldc', 'data', 'transformer_v2_CAN_exp');

folder_list = dir(sprintf('%s',datapath));
del_log_list = [];
for i = 1:length(folder_list)
    if strcmp(folder_list(i).name,'desktop.ini') | strcmp(folder_list(i).name,'.') | strcmp(folder_list(i).name,'..') | strcmp(folder_list(i).name,'.DS_Store' )      % 'desktop.ini' is a hidden file created by google drive in each directory. 
        del_log_list(end+1) = i;                                                                                    % It is deleted from the list since it is not useful for the program.
    end
end
folder_list(del_log_list) = [];

n_folders = length(folder_list);


for i = 1:n_models

    results.(models_to_test(i)).failures = 0;

    for j = 1:n_folders
        name_tmp = strsplit(folder_list(j).name, "\\") ;
        last_folder = string(name_tmp{end});
        fprintf("looking for %s in %s: ", models_to_test(i), last_folder)

        if contains(last_folder, models_to_test(i))
            fprintf("match\n")
            inertia_str = char(name_tmp);
            inertia_str = inertia_str(end-1:end);
            fprintf("%s\n", inertia_str)

            switch inertia_str
                case '13'
                    fprintf("config 2\n")
                    config = 2;

                case '05'
                    fprintf("config 1\n")
                    config = 1;

                case '15'
                    fprintf("config 3\n")
                    config = 3;

                case '09'
                    fprintf("config 4\n")
                    config = 4;

                case '11'
                    fprintf("config 5\n")
                    config = 5;

                case '07'
                    fprintf("config 6\n")
                    config = 6;

                otherwise
                    fprintf("............\n............\nerror\n............\n............\n")
                    error("aaaaaaaaaaaa")

            end
            
            current_path = fullfile(folder_list(j).folder, folder_list(j).name);
            current_file_list = dir(sprintf('%s',current_path));
            
            del_log_list = [];
            
            for ii = 1:length(current_file_list)
                if strcmp(current_file_list(ii).name,'desktop.ini') | strcmp(current_file_list(ii).name,'.') | strcmp(current_file_list(ii).name,'..') | strcmp(current_file_list(ii).name,'.DS_Store' ) | ~contains(current_file_list(ii).name, 'metadata')      % 'desktop.ini' is a hidden file created by google drive in each directory. 
                    del_log_list(end+1) = ii;                                                                                    % It is deleted from the list since it is not useful for the program.
                end
            end
            
            current_file_list(del_log_list) = [];

            inertia_field = sprintf("I%d", config);

            results.(models_to_test(i)).(inertia_field).T_s = zeros(length(current_file_list),1);
            results.(models_to_test(i)).(inertia_field).OS = zeros(length(current_file_list),1);

            results.(models_to_test(i)).(inertia_field).mean_regime = zeros(length(current_file_list),1);
            results.(models_to_test(i)).(inertia_field).std_regime = zeros(length(current_file_list),1);
            
            results.(models_to_test(i)).(inertia_field).full_data = zeros(length(current_file_list),4,501); %% (experiment_idx, time /ref /omega /i_q_ref, time_idx)
            
            for jj = 1:length(current_file_list)

                current_file = fullfile(current_file_list(jj).folder, current_file_list(jj).name);
                res_tmp = load(current_file);
                % 
                % if res_tmp.metadata.T_s > 2
                %     T_s_tmp = inf;
                % else
                %     T_s_tmp = res_tmp.metadata.T_s;
                % end

                results.(models_to_test(i)).(inertia_field).T_s(jj) = res_tmp.metadata.T_s;
                results.(models_to_test(i)).(inertia_field).OS(jj) = res_tmp.metadata.OS;

                if (res_tmp.metadata.T_s >=1.5) || (res_tmp.metadata.OS>=20)
                    results.(models_to_test(i)).failures = results.(models_to_test(i)).failures + 1;
                end
                tmp = strsplit(current_file_list(jj).name, "_metadata");
                csv_filename = tmp{1} + ".csv";
                current_file = fullfile(current_file_list(jj).folder, csv_filename);
                res_tmp = readtable(current_file);
                r = res_tmp.r;
                start_idx = max(1, find(r>1800,1,"first") - 1);
                end_idx = start_idx + 500;
                condensed_exp = [(res_tmp.t(start_idx:end_idx) - res_tmp.t(start_idx))';
                                 (res_tmp.r(start_idx:end_idx))';
                                 (res_tmp.omega(start_idx:end_idx))';
                                 (res_tmp.iq(start_idx:end_idx))'];
                results.(models_to_test(i)).(inertia_field).full_data(jj,:,:) = condensed_exp;

                results.(models_to_test(i)).(inertia_field).mean_regime(jj) = mean(res_tmp.omega(end_idx-300:end_idx) - res_tmp.r(end_idx-300:end_idx));
                results.(models_to_test(i)).(inertia_field).std_regime(jj) = std(res_tmp.omega(end_idx-300:end_idx) - res_tmp.r(end_idx-300:end_idx));


            end





        else
            fprintf("no match\n")
        end

    end % n_folders

end % n_models


columns = ["Model", ...
           "num_params",...
           "failures",...
           "Ts1", ...
           "Ts2", ...
           "Ts3", ...
           "Ts4", ...
           "Ts5", ...
           "Ts6", ...
           "Ts_mean", ...
           "Ts_mean_light", ...
           "OS1", ...
           "OS2", ...
           "OS3", ...
           "OS4", ...
           "OS5", ...
           "OS6", ...
           "OS_mean", ...
           "OS_mean_light", ...
           "mean_err1", ...
           "mean_err2", ...
           "mean_err3", ...
           "mean_err4", ...
           "mean_err5", ...
           "mean_err6", ...
           "mean_err_mean", ...
           "mean_err_mean_light", ...
           "std_err1", ...
           "std_err2", ...
           "std_err3", ...
           "std_err4", ...
           "std_err5", ...
           "std_err6", ...
           "std_err_mean", ...
           "std_err_mean_light", ...
           ];
vartypes = [   "string", ...
               "int32",...
               "int32",...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               "double", ...
               ];


T = table('Size', [n_models, length(columns)], ...
          'VariableTypes', vartypes, ...
          'VariableNames', columns);

for i = 1:n_models

    Ts = zeros(6,1);
    OS = zeros(6,1);
    mean_regime = zeros(6,1);
    std_regime = zeros(6,1);
    
    Ts(1) = mean(results.(models_to_test(i)).I1.T_s);
    Ts(2) = mean(results.(models_to_test(i)).I2.T_s);
    Ts(3) = mean(results.(models_to_test(i)).I3.T_s);
    Ts(4) = mean(results.(models_to_test(i)).I4.T_s);
    Ts(5) = mean(results.(models_to_test(i)).I5.T_s);
    Ts(6) = mean(results.(models_to_test(i)).I6.T_s);
    Ts_mean = mean(Ts);
    Ts_mean_light = mean(Ts(1:3));



    OS(1) = mean(results.(models_to_test(i)).I1.OS);
    OS(2) = mean(results.(models_to_test(i)).I2.OS);
    OS(3) = mean(results.(models_to_test(i)).I3.OS);
    OS(4) = mean(results.(models_to_test(i)).I4.OS);
    OS(5) = mean(results.(models_to_test(i)).I5.OS);
    OS(6) = mean(results.(models_to_test(i)).I6.OS);
    OS_mean = mean(OS);
    OS_mean_light = mean(OS(1:3));


    mean_regime(1) = mean(results.(models_to_test(i)).I1.mean_regime);
    mean_regime(2) = mean(results.(models_to_test(i)).I2.mean_regime);
    mean_regime(3) = mean(results.(models_to_test(i)).I3.mean_regime);
    mean_regime(4) = mean(results.(models_to_test(i)).I4.mean_regime);
    mean_regime(5) = mean(results.(models_to_test(i)).I5.mean_regime);
    mean_regime(6) = mean(results.(models_to_test(i)).I6.mean_regime);
    mean_regime_mean = mean(mean_regime);
    mean_regime_mean_light = mean(mean_regime(1:3));

    std_regime(1) = mean(results.(models_to_test(i)).I1.std_regime);
    std_regime(2) = mean(results.(models_to_test(i)).I2.std_regime);
    std_regime(3) = mean(results.(models_to_test(i)).I3.std_regime);
    std_regime(4) = mean(results.(models_to_test(i)).I4.std_regime);
    std_regime(5) = mean(results.(models_to_test(i)).I5.std_regime);
    std_regime(6) = mean(results.(models_to_test(i)).I6.std_regime);
    std_regime_mean = mean(std_regime);
    std_regime_mean_light = mean(std_regime(1:3));






    T(i,:) = table(models_to_test(i), ...
             num_params(i),...
             results.(models_to_test(i)).failures,...
             Ts(1),...
             Ts(2),...
             Ts(3),...
             Ts(4),...
             Ts(5),...
             Ts(6),...
             Ts_mean,...
             Ts_mean_light,...
             OS(1),...
             OS(2),...
             OS(3),...
             OS(4),...
             OS(5),...
             OS(6),...
             OS_mean,...
             OS_mean_light,...
             mean_regime(1),...
             mean_regime(2),...
             mean_regime(3),...
             mean_regime(4),...
             mean_regime(5),...
             mean_regime(6),...
             mean_regime_mean,...
             mean_regime_mean_light,...
             std_regime(1),...
             std_regime(2),...
             std_regime(3),...
             std_regime(4),...
             std_regime(5),...
             std_regime(6),...
             std_regime_mean,...
             std_regime_mean_light,...
             'VariableNames', columns);
    

end

writetable(T, "exp_results_CAN_2/model_comparison.xlsx")


% T{:,["Model", "Ts_mean_light", "OS_mean_light", "mean_err_mean_light", "std_err_mean_light"]}
T_short = T(:,["Model", "num_params", "failures", "Ts_mean_light", "OS_mean_light", "mean_err_mean_light", "std_err_mean_light"]);

writetable(T_short, "exp_results_CAN_2/model_comparison_short.xlsx")






inertia = "I1";


time = reshape(results.(models_to_test(1)).(inertia).full_data(1,1,:), 1,[]);


% colors_good = color_tints_and_shades([0    0.4471    0.7412],4,0.8);
colors_good = flip(color_tints_and_shades([116, 198, 157]/255,5,0.6));

figure
hold on
for i = 1:4

    name_curr = models_to_test(i)

    omegas = results.(models_to_test(i)).(inertia).full_data(:,3,:);

    plot(time, reshape(omegas(1,1,:), 1,[]), 'DisplayName', models_to_test(i), 'Color', colors_good{i})


end
ylim([1500,2500])
xlim([0,1])
legend('Interpreter','none')


figure
hold on
for i = 4:8

    omegas = results.(models_to_test(i)).(inertia).full_data(:,3,:);

    plot(time, reshape(omegas(1,1,:), 1,[]), 'DisplayName', models_to_test(i), 'Color', colors_good{i-3})


end
ylim([1500,2500])
xlim([0,1])
legend('Interpreter','none')





